# Copy to .env and fill in. Never commit .env.

# Public domain that points to this server (A/AAAA record). Caddy obtains the
# HTTPS certificate automatically; Telegram only opens Mini Apps over HTTPS.
VESTNIO_DOMAIN=news.example.com

# PostgreSQL password (any long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# From @BotFather. Used only by the `bot` and `api` services; never sent to the browser.
VESTNIO_BOT_TOKEN=

# Optional: Telegram user ids allowed to call admin endpoints (comma-separated)
VESTNIO_ADMIN_IDS=

# Optional: The Guardian Open Platform key (enables the guardian-api-world source)
VESTNIO_GUARDIAN_API_KEY=

VESTNIO_LOG_LEVEL=INFO
