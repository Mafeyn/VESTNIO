# Local development (backend/.env). `python scripts/dev_db.py` fills in the database URLs.
VESTNIO_DATABASE_URL=postgresql+asyncpg://vestnio:vestnio@localhost:5432/vestnio
VESTNIO_TEST_DATABASE_URL=postgresql+asyncpg://vestnio:vestnio@localhost:5432/vestnio_test
VESTNIO_LOG_LEVEL=INFO

# Telegram (only needed to run the bot / admin endpoints locally)
VESTNIO_BOT_TOKEN=
VESTNIO_WEBAPP_URL=https://your-tunnel.trycloudflare.com/
VESTNIO_ADMIN_IDS=

VESTNIO_GUARDIAN_API_KEY=
